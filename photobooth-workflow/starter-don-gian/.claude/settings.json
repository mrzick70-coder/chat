{
  "permissions": {
    "defaultMode": "acceptEdits",
    "allow": [
      "Bash(git init:*)",
      "Bash(git status:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git log:*)",
      "Bash(git diff:*)",
      "Bash(git show:*)",
      "Bash(git revert:*)",
      "Bash(ls:*)",
      "Bash(chmod +x:*)"
    ],
    "deny": [
      "Bash(git reset --hard:*)",
      "Bash(git push --force:*)",
      "Bash(git clean:*)"
    ]
  }
}
